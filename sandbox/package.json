{
  "name": "bidezine-sandbox-app",
  "version": "0.0.0",
  "description": "Factory-line transformation tracker for components moving out of the Sandbox, built from @bidezine/system.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "origin:install": "npm --prefix ../origin/rail-sidebar/app install",
    "origin:build": "npm --prefix ../origin/rail-sidebar/app run build",
    "predev": "npm run origin:build",
    "dev": "vite --port 4199 --strictPort",
    "build": "node ../scripts/check-quarantine.mjs && npm run origin:build && tsc --noEmit && vite build",
    "preview": "vite preview --port 4199 --strictPort",
    "check:quarantine": "node ../scripts/check-quarantine.mjs",
    "check:origin-pane": "node ../scripts/verify-origin-quarantine.mjs",
    "verify": "node verify-approval.mjs",
    "verify-readonly": "node verify-readonly.mjs",
    "verify-ui": "node verify-machines-ui.mjs",
    "verify-cards": "node verify-review-cards.mjs"
  },
  "dependencies": {
    "@bidezine/system": "file:..",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-presence": "^1.1.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
