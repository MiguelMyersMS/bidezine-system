# bidezine-system — environment template
#
# Copy this file to `.env` on EACH machine and fill in the values. NEVER commit `.env`
# (it is gitignored). Secrets do not travel through git — set them per machine.

# Machine identity — used by HANDOFF.md's "one section per machine" protocol so an AI session
# can tell which section it's allowed to write to WITHOUT having to ask or guess. Set this once,
# per machine, to the exact section heading this machine owns in HANDOFF.md: "Laptop A", "Laptop B",
# or "PC". MACHINE_OWNER is just the human's name, for readability in logs/prompts.
MACHINE_NAME=
MACHINE_OWNER=

# Figma personal access token (used by the figma-developer-mcp server in .mcp.json)
FIGMA_API_KEY=

# ── Sandbox — Fabric SQL Database (docs/SANDBOX-SPEC.md, Milestone 1) ────────────────
# The Sandbox's operational store. Provisioned once in the Fabric portal, then every
# machine connects to the SAME database using its own service-principal credentials.
#
# FABRIC_SQL_SERVER   — the SQL connection string / server FQDN shown in the Fabric SQL
#                       database's Settings → Connection strings. Ends in
#                       `.database.fabric.microsoft.com`.
# FABRIC_SQL_DATABASE — the database name as shown in the workspace.
# FABRIC_TENANT_ID    — Entra ID (Azure AD) tenant/directory ID.
# FABRIC_CLIENT_ID    — Application (client) ID of the app registration used as the
#                       service principal.
# FABRIC_CLIENT_SECRET— that app registration's client secret VALUE (not its ID).
#                       Secret. Generate a separate one per machine where practical, so
#                       it can be revoked alone and the audit trail stays per-machine.
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# Cloudflare — for deploying the verification site.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
