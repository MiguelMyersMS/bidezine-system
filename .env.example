# bidezine-system — environment template
#
# Copy this file to `.env` on EACH machine and fill in the values. NEVER commit `.env`
# (it is gitignored). Secrets do not travel through git — set them per machine.

# Machine identity — used by HANDOFF.md's "one section per machine" protocol so an AI session
# can tell which section it's allowed to write to WITHOUT having to ask or guess. Set this once,
# per machine, to the exact section heading this machine owns in HANDOFF.md: "Laptop A", "Laptop B",
# or "PC". MACHINE_OWNER is just the human's name, for readability in logs/prompts.
MACHINE_NAME=
MACHINE_OWNER=

# Figma personal access token (used by the figma-developer-mcp server in .mcp.json)
FIGMA_API_KEY=

# Cloudflare — for deploying the verification site.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
