node_modules/
dist/

# GENERATED from tokens/*.tokens.json by scripts/build-tokens.mjs.
# Not committed: three machines share `main`, and a generated file would conflict
# on every token change in addition to its own source. `pretokens` hooks on the
# dev/build/typecheck scripts regenerate them. See docs/process/TOKEN-PIPELINE.md.
src/styles/tokens.css
src/tokens.ts

# GENERATED from icons/manifest.json by scripts/build-icons.mjs. Same reasoning
# as the token files above: not committed, regenerated by the pre* hooks.
src/icons/generated.tsx
storybook-static/
.wrangler/
test-results/
.env
.env.*
!.env.example
!.env.copilot.example
*.tgz

# Generated reports
*.report.pdf

# .claude — track only shared machinery, not per-machine local config
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
!.claude/commands/

# Scratch / temp
tmp/
scratchpad/
scratch_img.*
.reseal-needed

# Per-machine editor/agent config — must NOT travel between machines
.vscode/
.codex/

# Vendored shadcn reference — keep the SOURCE, ignore any build artifacts inside it
reference/shadcn-ui/**/node_modules/
reference/shadcn-ui/**/dist/
reference/shadcn-ui/**/.next/
reference/shadcn-ui/**/.turbo/

# Sandbox verifier — screenshot artifacts. Regenerable, and their sha256 is recorded in
# sandbox.evidence.artifact_hash, so the database already holds the part that matters.
verifier/artifacts/
