{
  "name": "@bidezine/system",
  "version": "0.0.0",
  "description": "Design system built from the vendored shadcn/ui source, deployed to a verification site.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/system.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "prebuild": "npm run tokens",
    "build": "vite build",
    "pretypecheck": "npm run tokens",
    "typecheck": "tsc --noEmit",
    "site:dev": "npm run build && npm --prefix site install && npm --prefix site run dev",
    "site:build": "npm run build && npm --prefix site install && npm --prefix site run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.6.0",
    "@base-ui/react": "1.6.0",
    "input-otp": "^1.4.2",
    "react-hook-form": "^7.62.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
