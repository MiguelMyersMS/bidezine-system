{
  "name": "@bidezine/system",
  "version": "0.0.0",
  "description": "Design system built from the vendored shadcn/ui source, deployed to a verification site.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/system.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "node scripts/build-icons.mjs",
    "prebuild": "npm run tokens && npm run icons",
    "build": "vite build",
    "pretypecheck": "npm run tokens && npm run icons",
    "typecheck": "tsc --noEmit",
    "site:dev": "npm run build && npm --prefix site install && npm --prefix site run dev",
    "site:build": "npm run build && npm --prefix site install && npm --prefix site run build",
    "check-shipped": "node scripts/check-shipped-tokens.mjs",
    "check-type-slots": "node scripts/check-type-slots.mjs",
    "check-rules": "node scripts/check-rules.mjs",
    "check-all": "npm run build && npm run check-shipped && npm run check-type-slots && npm run typecheck && npm run check-rules"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fluentui/svg-icons": "1.1.334",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.5.2",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
