{
  "$description": "shadcn/ui's own 'Emerald' preset theme (new-york style), unmodified. Overrides only the 24 classic shadcn theme-surface colour tokens (background/foreground, card, popover, primary, secondary, muted, accent and destructive — each with its -foreground — plus border, input, ring and chart-1..5), so it drops in as an alternate [data-theme] block. It does NOT override the system's other 79 base colour tokens, which inherit the base theme: the success/warning/info status families and their -soft variants, the sidebar-* and sidebar-rail-* tokens, surface-sunken, border-strong, surface-contrast, and the fixed-mode dark-*/light-* mirrors. Its light and dark blocks differ, so the preset is mode-responsive.",

  "light": {
    "background": { "$type": "color", "$value": "hsl(0 0% 100%)" },
    "foreground": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "card": { "$type": "color", "$value": "hsl(0 0% 100%)" },
    "card-foreground": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "popover": { "$type": "color", "$value": "hsl(0 0% 100%)" },
    "popover-foreground": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "primary": { "$type": "color", "$value": "hsl(142 86% 28%)" },
    "primary-foreground": { "$type": "color", "$value": "hsl(356 29% 98%)" },
    "secondary": { "$type": "color", "$value": "hsl(240 4.8% 95.9%)" },
    "secondary-foreground": { "$type": "color", "$value": "hsl(240 5.9% 10%)" },
    "muted": { "$type": "color", "$value": "hsl(240 4.8% 95.9%)" },
    "muted-foreground": { "$type": "color", "$value": "hsl(240 3.8% 45%)" },
    "accent": { "$type": "color", "$value": "hsl(240 4.8% 95.9%)" },
    "accent-foreground": { "$type": "color", "$value": "hsl(240 5.9% 10%)" },
    "destructive": { "$type": "color", "$value": "hsl(0 72% 51%)" },
    "destructive-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "border": { "$type": "color", "$value": "hsl(240 5.9% 90%)" },
    "input": { "$type": "color", "$value": "hsl(240 5.9% 90%)" },
    "ring": { "$type": "color", "$value": "hsl(142 86% 28%)" },
    "chart-1": { "$type": "color", "$value": "hsl(139 65% 20%)" },
    "chart-2": { "$type": "color", "$value": "hsl(140 74% 44%)" },
    "chart-3": { "$type": "color", "$value": "hsl(142 88% 28%)" },
    "chart-4": { "$type": "color", "$value": "hsl(137 55% 15%)" },
    "chart-5": { "$type": "color", "$value": "hsl(141 40% 9%)" }
  },

  "dark": {
    "background": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "card": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "card-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "popover": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "popover-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "primary": { "$type": "color", "$value": "hsl(142 86% 28%)" },
    "primary-foreground": { "$type": "color", "$value": "hsl(356 29% 98%)" },
    "secondary": { "$type": "color", "$value": "hsl(240 4.8% 95.9%)" },
    "secondary-foreground": { "$type": "color", "$value": "hsl(240 5.9% 10%)" },
    "muted": { "$type": "color", "$value": "hsl(240 3.7% 15.9%)" },
    "muted-foreground": { "$type": "color", "$value": "hsl(240 5% 64.9%)" },
    "accent": { "$type": "color", "$value": "hsl(240 3.7% 15.9%)" },
    "accent-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "destructive": { "$type": "color", "$value": "hsl(0 72% 51%)" },
    "destructive-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "border": { "$type": "color", "$value": "hsl(240 3.7% 15.9%)" },
    "input": { "$type": "color", "$value": "hsl(240 3.7% 15.9%)" },
    "ring": { "$type": "color", "$value": "hsl(142 86% 28%)" },
    "chart-1": { "$type": "color", "$value": "hsl(142 88% 28%)" },
    "chart-2": { "$type": "color", "$value": "hsl(139 65% 20%)" },
    "chart-3": { "$type": "color", "$value": "hsl(140 74% 24%)" },
    "chart-4": { "$type": "color", "$value": "hsl(137 55% 15%)" },
    "chart-5": { "$type": "color", "$value": "hsl(141 40% 9%)" }
  }
}
