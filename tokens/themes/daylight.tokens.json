{
  "$description": "shadcn/ui's own 'Daylight' preset theme (new-york style), unmodified. Overrides only the 24 classic shadcn theme-surface colour tokens (background/foreground, card, popover, primary, secondary, muted, accent and destructive — each with its -foreground — plus border, input, ring and chart-1..5), so it drops in as an alternate [data-theme] block. It does NOT override the system's other 79 base colour tokens, which inherit the base theme: the success/warning/info status families and their -soft variants, the sidebar-* and sidebar-rail-* tokens, surface-sunken, border-strong, surface-contrast, and the fixed-mode dark-*/light-* mirrors. Its light and dark blocks are identical, so the preset renders the same in both modes.",

  "light": {
    "background": { "$type": "color", "$value": "hsl(36 39% 88%)" },
    "foreground": { "$type": "color", "$value": "hsl(36 45% 15%)" },
    "card": { "$type": "color", "$value": "hsl(36 46% 82%)" },
    "card-foreground": { "$type": "color", "$value": "hsl(36 45% 20%)" },
    "popover": { "$type": "color", "$value": "hsl(0 0% 100%)" },
    "popover-foreground": { "$type": "color", "$value": "hsl(240 10% 3.9%)" },
    "primary": { "$type": "color", "$value": "hsl(36 45% 70%)" },
    "primary-foreground": { "$type": "color", "$value": "hsl(36 45% 11%)" },
    "secondary": { "$type": "color", "$value": "hsl(40 35% 77%)" },
    "secondary-foreground": { "$type": "color", "$value": "hsl(36 45% 25%)" },
    "muted": { "$type": "color", "$value": "hsl(36 33% 75%)" },
    "muted-foreground": { "$type": "color", "$value": "hsl(36 45% 25%)" },
    "accent": { "$type": "color", "$value": "hsl(36 64% 57%)" },
    "accent-foreground": { "$type": "color", "$value": "hsl(36 72% 17%)" },
    "destructive": { "$type": "color", "$value": "hsl(0 84% 37%)" },
    "destructive-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "border": { "$type": "color", "$value": "hsl(36 45% 60%)" },
    "input": { "$type": "color", "$value": "hsl(36 45% 60%)" },
    "ring": { "$type": "color", "$value": "hsl(36 45% 30%)" },
    "chart-1": { "$type": "color", "$value": "hsl(25 34% 28%)" },
    "chart-2": { "$type": "color", "$value": "hsl(26 36% 34%)" },
    "chart-3": { "$type": "color", "$value": "hsl(28 40% 40%)" },
    "chart-4": { "$type": "color", "$value": "hsl(31 41% 48%)" },
    "chart-5": { "$type": "color", "$value": "hsl(35 43% 53%)" }
  },

  "dark": {
    "background": { "$type": "color", "$value": "hsl(36 39% 88%)" },
    "foreground": { "$type": "color", "$value": "hsl(36 45% 15%)" },
    "card": { "$type": "color", "$value": "hsl(36 46% 82%)" },
    "card-foreground": { "$type": "color", "$value": "hsl(36 45% 20%)" },
    "popover": { "$type": "color", "$value": "hsl(0 0% 100%)" },
