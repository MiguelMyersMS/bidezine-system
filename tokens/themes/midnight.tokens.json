{
  "$description": "shadcn/ui's own 'Midnight' preset theme (new-york style), unmodified. Overrides only the 24 classic shadcn theme-surface colour tokens (background/foreground, card, popover, primary, secondary, muted, accent and destructive — each with its -foreground — plus border, input, ring and chart-1..5), so it drops in as an alternate [data-theme] block. It does NOT override the system's other 79 base colour tokens, which inherit the base theme: the success/warning/info status families and their -soft variants, the sidebar-* and sidebar-rail-* tokens, surface-sunken, border-strong, surface-contrast, and the fixed-mode dark-*/light-* mirrors. Its light and dark blocks are identical, so the preset renders the same in both modes.",

  "light": {
    "background": { "$type": "color", "$value": "hsl(240 5% 6%)" },
    "foreground": { "$type": "color", "$value": "hsl(60 5% 90%)" },
    "card": { "$type": "color", "$value": "hsl(240 4% 10%)" },
    "card-foreground": { "$type": "color", "$value": "hsl(60 5% 90%)" },
    "popover": { "$type": "color", "$value": "hsl(240 5% 15%)" },
    "popover-foreground": { "$type": "color", "$value": "hsl(60 5% 85%)" },
    "primary": { "$type": "color", "$value": "hsl(240 0% 90%)" },
    "primary-foreground": { "$type": "color", "$value": "hsl(60 0% 0%)" },
    "secondary": { "$type": "color", "$value": "hsl(240 4% 15%)" },
    "secondary-foreground": { "$type": "color", "$value": "hsl(60 5% 85%)" },
    "muted": { "$type": "color", "$value": "hsl(240 5% 25%)" },
    "muted-foreground": { "$type": "color", "$value": "hsl(60 5% 85%)" },
    "accent": { "$type": "color", "$value": "hsl(240 0% 13%)" },
    "accent-foreground": { "$type": "color", "$value": "hsl(60 0% 100%)" },
    "destructive": { "$type": "color", "$value": "hsl(0 60% 50%)" },
    "destructive-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "border": { "$type": "color", "$value": "hsl(240 6% 20%)" },
    "input": { "$type": "color", "$value": "hsl(240 6% 20%)" },
    "ring": { "$type": "color", "$value": "hsl(240 5% 90%)" },
    "chart-1": { "$type": "color", "$value": "hsl(359 2% 90%)" },
    "chart-2": { "$type": "color", "$value": "hsl(240 1% 74%)" },
    "chart-3": { "$type": "color", "$value": "hsl(240 1% 58%)" },
    "chart-4": { "$type": "color", "$value": "hsl(240 1% 42%)" },
    "chart-5": { "$type": "color", "$value": "hsl(240 2% 26%)" }
  },

  "dark": {
    "background": { "$type": "color", "$value": "hsl(240 5% 6%)" },
    "foreground": { "$type": "color", "$value": "hsl(60 5% 90%)" },
    "card": { "$type": "color", "$value": "hsl(240 4% 10%)" },
    "card-foreground": { "$type": "color", "$value": "hsl(60 5% 90%)" },
    "popover": { "$type": "color", "$value": "hsl(240 5% 15%)" },
    "popover-foreground": { "$type": "color", "$value": "hsl(60 5% 85%)" },
    "primary": { "$type": "color", "$value": "hsl(240 0% 90%)" },
    "primary-foreground": { "$type": "color", "$value": "hsl(60 0% 0%)" },
    "secondary": { "$type": "color", "$value": "hsl(240 4% 15%)" },
    "secondary-foreground": { "$type": "color", "$value": "hsl(60 5% 85%)" },
    "muted": { "$type": "color", "$value": "hsl(240 5% 25%)" },
    "muted-foreground": { "$type": "color", "$value": "hsl(60 5% 85%)" },
    "accent": { "$type": "color", "$value": "hsl(240 0% 13%)" },
    "accent-foreground": { "$type": "color", "$value": "hsl(60 0% 100%)" },
    "destructive": { "$type": "color", "$value": "hsl(0 60% 50%)" },
    "destructive-foreground": { "$type": "color", "$value": "hsl(0 0% 98%)" },
    "border": { "$type": "color", "$value": "hsl(240 6% 20%)" },
    "input": { "$type": "color", "$value": "hsl(240 6% 20%)" },
    "ring": { "$type": "color", "$value": "hsl(240 5% 90%)" },
    "chart-1": { "$type": "color", "$value": "hsl(359 2% 90%)" },
    "chart-2": { "$type": "color", "$value": "hsl(240 1% 74%)" },
    "chart-3": { "$type": "color", "$value": "hsl(240 1% 58%)" },
    "chart-4": { "$type": "color", "$value": "hsl(240 1% 42%)" },
    "chart-5": { "$type": "color", "$value": "hsl(240 2% 26%)" }
  }
}
