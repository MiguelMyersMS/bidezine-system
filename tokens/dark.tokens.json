{
  "$description": "Dark-mode semantic colors → .dark. Must declare exactly the same token names as light.tokens.json — the emitter fails the build on any mismatch (light/dark parity gate).",
  "background": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },
  "foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "card": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
  "card-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "popover": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
  "popover-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "primary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
  "primary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },

  "secondary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.269, 0, 0] } },
  "secondary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "muted": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.269, 0, 0] } },
  "muted-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] } },

  "accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.371, 0, 0] } },
  "accent-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "destructive": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.704, 0.191, 22.216] } },
  "destructive-foreground": {
    "$type": "color",
    "$description": "NEAR-BLACK in dark, and this token therefore INVERTS by mode. Measured: the dark destructive fill is #ff6467, a much lighter red than light mode's #e7000b. Near-white on it scores 2.77:1 — a clear WCAG 1.4.3 failure. Near-black scores 6.84:1. My step-5 redefinition checked light (4.57, barely passing) and not dark; this corrects it.",
    "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] }
  },

  "border": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.1 } },
  "input": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.15 } },
  "ring": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.556, 0, 0] } },
  "focus-ring": { "$type": "color", "$description": "`ring` at 50%, dark mode. Dark `ring` (0.556) already measures 4.18:1 against the dark background, so no correction was needed on this side — the failure was light-mode only.", "$value": { "colorSpace": "oklch", "components": [0.556, 0, 0], "alpha": 0.5 } },

  "backdrop": {
    "$type": "color",
    "$description": "Heavier in dark, matching v1's light 0.40 / dark 0.60 split.",
    "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.6 }
  },

  "shadow-subtle": { "$type": "color", "$description": "Shadow ink, dark mode: pure black at ~2.5x the light alpha.", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1 } },
  "shadow-light": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15 } },
  "shadow-medium": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.25 } },
  "shadow-strong": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.35 } },

  "shadow-flat": {
    "$type": "shadow",
    "$description": "Dark shadows are pure black and roughly 2.5x the light alpha — v1's elevation is theme-aware, which is the defect R-09 fixes in shadcn's fixed-alpha shadow-lg.",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-low": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-mid": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.25 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-high": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.35 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-overlay": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.35 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.15 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  }
}
