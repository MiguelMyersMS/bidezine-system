{
  "$description": "Mode-independent tokens, mirroring shadcn/ui's own theme. DTCG 2025.10. Source of truth — emits src/styles/tokens.css + src/tokens.ts via `npm run tokens`. Never hand-write a CSS variable.\n\nOnly what shadcn defines lives here. Inter is the system sans face; named type roles remain Tailwind utility mappings until the typography lab promotes them to authored tokens. Spacing, opacity, breakpoints and shadows are Tailwind defaults and need no token until something actually demands one.",

  "radius": {
    "$type": "dimension",
    "$description": "Base corner radius. shadcn derives the steps below from this with calc(); we author them explicitly because the values also have to be readable by tooling that has no calc().",
    "$value": { "value": 0.625, "unit": "rem" }
  },
  "radius-sm": { "$type": "dimension", "$description": "0.6x base.", "$value": { "value": 0.375, "unit": "rem" } },
  "radius-md": { "$type": "dimension", "$description": "0.8x base.", "$value": { "value": 0.5, "unit": "rem" } },
  "radius-lg": { "$type": "dimension", "$description": "1.0x base.", "$value": { "value": 0.625, "unit": "rem" } },
  "radius-xl": { "$type": "dimension", "$description": "1.4x base.", "$value": { "value": 0.875, "unit": "rem" } },
  "radius-2xl": { "$type": "dimension", "$description": "1.8x base.", "$value": { "value": 1.125, "unit": "rem" } },
  "radius-3xl": { "$type": "dimension", "$description": "2.2x base.", "$value": { "value": 1.375, "unit": "rem" } },
  "radius-4xl": { "$type": "dimension", "$description": "2.6x base.", "$value": { "value": 1.625, "unit": "rem" } },

  "font-sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
  "font-mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] },

  "motion-duration-fast": { "$type": "duration", "$description": "100ms. Two explicit uses in src/ui.", "$value": { "value": 100, "unit": "ms" } },
  "motion-duration-base": { "$type": "duration", "$description": "150ms. Tailwind's --default-transition-duration, which system.css does not override — 33 transitions across 26 src/ui files run at it today, including Button's own base recipe. The most-used duration in the system by a wide margin, and the one you get without asking.", "$value": { "value": 150, "unit": "ms" } },
  "motion-duration-moderate": { "$type": "duration", "$description": "200ms. The most common DELIBERATE duration — 8 explicit duration-200 usages (accordion, dialog, alert-dialog, navigation-menu, sidebar, message-scroller).", "$value": { "value": 200, "unit": "ms" } },
  "motion-duration-slow": { "$type": "duration", "$description": "300ms. Two explicit uses.", "$value": { "value": 300, "unit": "ms" } },

  "motion-ease-linear": { "$type": "cubicBezier", "$description": "Tailwind's ease-linear, four uses in src/ui.", "$value": [0, 0, 1, 1] },
  "motion-ease-in-out": { "$type": "cubicBezier", "$description": "Tailwind's ease-in-out, read from node_modules/tailwindcss. One use in src/ui.", "$value": [0.4, 0, 0.2, 1] },

  "font-size-12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
  "font-size-14": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
  "font-size-16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
  "font-size-18": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
  "font-size-20": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
  "font-size-24": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
  "font-size-32": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },

  "font-weight-regular": { "$type": "fontWeight", "$value": 400 },
  "font-weight-medium": { "$type": "fontWeight", "$value": 500 },
  "font-weight-semibold": { "$type": "fontWeight", "$value": 600 },

  "letter-spacing-tight": { "$type": "dimension", "$value": { "value": -0.025, "unit": "em" } },
  "letter-spacing-normal": { "$type": "dimension", "$value": { "value": 0, "unit": "em" } },
  "letter-spacing-wide": { "$type": "dimension", "$value": { "value": 0.01, "unit": "em" } },
  "letter-spacing-wider": { "$type": "dimension", "$value": { "value": 0.025, "unit": "em" } },
  "letter-spacing-widest": { "$type": "dimension", "$value": { "value": 0.1, "unit": "em" } },

  "type-display": {
    "$type": "typography",
    "$description": "Largest heading, for documentation surfaces — hero titles, landing-page headers.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-32}",
      "lineHeight": { "value": 36.8, "unit": "px" },
      "fontWeight": "{font-weight-semibold}",
      "letterSpacing": "{letter-spacing-tight}"
    }
  },
  "type-heading-lg": {
    "$type": "typography",
    "$description": "Largest in-app heading — page titles, top-level section headers.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-24}",
      "lineHeight": { "value": 32, "unit": "px" },
      "fontWeight": "{font-weight-semibold}",
      "letterSpacing": "{letter-spacing-tight}"
    }
  },
  "type-heading": {
    "$type": "typography",
    "$description": "Section heading — dialog titles, card titles, sub-sections.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-20}",
      "lineHeight": { "value": 28, "unit": "px" },
      "fontWeight": "{font-weight-semibold}",
      "letterSpacing": "{letter-spacing-tight}"
    }
  },
  "type-heading-sm": {
    "$type": "typography",
    "$description": "Small heading — nested sections, sidebar group titles. Line height equals font size: it sits on a single tight line, not a flowing paragraph.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-18}",
      "lineHeight": { "value": 18, "unit": "px" },
      "fontWeight": "{font-weight-semibold}",
      "letterSpacing": "{letter-spacing-tight}"
    }
  },
  "type-body-lg": {
    "$type": "typography",
    "$description": "Larger body copy — lead paragraphs, empty-state descriptions.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-16}",
      "lineHeight": { "value": 24, "unit": "px" },
      "fontWeight": "{font-weight-regular}",
      "letterSpacing": "{letter-spacing-normal}"
    }
  },
  "type-body": {
    "$type": "typography",
    "$description": "Default running text — paragraphs, descriptions, list items.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-14}",
      "lineHeight": { "value": 20, "unit": "px" },
      "fontWeight": "{font-weight-regular}",
      "letterSpacing": "{letter-spacing-normal}"
    }
  },
  "type-body-strong": {
    "$type": "typography",
    "$description": "Emphasised inline text within body copy — same metrics as type-body, heavier weight.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-14}",
      "lineHeight": { "value": 20, "unit": "px" },
      "fontWeight": "{font-weight-medium}",
      "letterSpacing": "{letter-spacing-normal}"
    }
  },
  "type-control": {
    "$type": "typography",
    "$description": "Button, input, tab and menu item label. Tight line height — it is centred in a control, not flowing.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-14}",
      "lineHeight": { "value": 20, "unit": "px" },
      "fontWeight": "{font-weight-medium}",
      "letterSpacing": "{letter-spacing-normal}"
    }
  },
  "type-caption": {
    "$type": "typography",
    "$description": "Secondary/supporting text — helper text, timestamps, metadata.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-12}",
      "lineHeight": { "value": 16, "unit": "px" },
      "fontWeight": "{font-weight-regular}",
      "letterSpacing": "{letter-spacing-wide}"
    }
  },
  "type-label": {
    "$type": "typography",
    "$description": "Uppercase field/group label — form labels, section eyebrows.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-12}",
      "lineHeight": { "value": 16, "unit": "px" },
      "fontWeight": "{font-weight-medium}",
      "letterSpacing": "{letter-spacing-wider}",
      "textTransform": "uppercase"
    }
  },
  "type-metric": {
    "$type": "typography",
    "$description": "Large numeric statistic, for documentation surfaces — dashboards, stat cards. Tabular figures so digits don't shift width.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-32}",
      "lineHeight": { "value": 33.6, "unit": "px" },
      "fontWeight": "{font-weight-semibold}",
      "letterSpacing": "{letter-spacing-tight}",
      "fontVariantNumeric": "tabular-nums"
    }
  },
  "type-metric-sm": {
    "$type": "typography",
    "$description": "Smaller numeric statistic — compact stat cards, inline metrics. Tabular figures so digits don't shift width.",
    "$value": {
      "fontFamily": "{font-sans}",
      "fontSize": "{font-size-20}",
      "lineHeight": { "value": 22, "unit": "px" },
      "fontWeight": "{font-weight-semibold}",
      "letterSpacing": "{letter-spacing-tight}",
      "fontVariantNumeric": "tabular-nums"
    }
  },
  "type-code": {
    "$type": "typography",
    "$description": "Inline and block code — monospace body text.",
    "$value": {
      "fontFamily": "{font-mono}",
      "fontSize": "{font-size-14}",
      "lineHeight": { "value": 20, "unit": "px" },
      "fontWeight": "{font-weight-regular}",
      "letterSpacing": "{letter-spacing-normal}"
    }
  },
  "type-kbd": {
    "$type": "typography",
    "$description": "Keyboard shortcut / key-cap label — monospace, widest tracking for legibility at small size.",
    "$value": {
      "fontFamily": "{font-mono}",
      "fontSize": "{font-size-12}",
      "lineHeight": { "value": 16, "unit": "px" },
      "fontWeight": "{font-weight-medium}",
      "letterSpacing": "{letter-spacing-widest}"
    }
  }
}
