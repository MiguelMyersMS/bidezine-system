{
  "$description": "Mode-independent tokens. DTCG 2025.10 (ADR-001). Source of truth — emits src/styles/tokens.css + src/tokens.ts via `npm run tokens`. DO NOT hand-write CSS variables.",
  "radius": {
    "$type": "dimension",
    "$description": "Base corner radius. The step scale below is authored explicitly rather than derived with calc() in CSS — Figma Variables cannot express calc(), so a derived scale would exist in CSS only and Figma would need hand-entered numbers that silently drift. Explicit steps keep one source for both.",
    "$value": { "value": 0.625, "unit": "rem" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "0.6x base.",
    "$value": { "value": 0.375, "unit": "rem" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "0.8x base. Buttons, inputs.",
    "$value": { "value": 0.5, "unit": "rem" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "1.0x base. Dialog surface.",
    "$value": { "value": 0.625, "unit": "rem" }
  },
  "radius-xl": {
    "$type": "dimension",
    "$description": "1.4x base.",
    "$value": { "value": 0.875, "unit": "rem" }
  },
  "font-sans": {
    "$type": "fontFamily",
    "$description": "UI typeface stack.",
    "$value": ["ui-sans-serif", "system-ui", "sans-serif"]
  },
  "font-mono": {
    "$type": "fontFamily",
    "$description": "Monospace stack for code and tabular figures.",
    "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
  },

  "font-size-xs": {
    "$type": "dimension",
    "$description": "12px. Button size=xs.",
    "$value": { "value": 0.75, "unit": "rem" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$description": "14px. The workhorse: labels, buttons, inputs, descriptions.",
    "$value": { "value": 0.875, "unit": "rem" }
  },
  "font-size-base": {
    "$type": "dimension",
    "$description": "16px. FieldLegend variant=legend.",
    "$value": { "value": 1, "unit": "rem" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$description": "18px. DialogTitle.",
    "$value": { "value": 1.125, "unit": "rem" }
  },

  "line-height-xs": {
    "$type": "dimension",
    "$description": "16px, paired with font-size-xs.",
    "$value": { "value": 1, "unit": "rem" }
  },
  "line-height-sm": {
    "$type": "dimension",
    "$description": "20px, paired with font-size-sm.",
    "$value": { "value": 1.25, "unit": "rem" }
  },
  "line-height-base": {
    "$type": "dimension",
    "$description": "24px, paired with font-size-base.",
    "$value": { "value": 1.5, "unit": "rem" }
  },
  "line-height-lg": {
    "$type": "dimension",
    "$description": "28px, paired with font-size-lg.",
    "$value": { "value": 1.75, "unit": "rem" }
  },

  "font-weight-normal": {
    "$type": "fontWeight",
    "$description": "400. Body and descriptions.",
    "$value": 400
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$description": "500. Labels and button text.",
    "$value": 500
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$description": "600. DialogTitle.",
    "$value": 600
  }
}
