{
  "$description": "Light-mode semantic colors → :root. Names are shadcn's contract vocabulary (so borrowed Radix behaviour compiles unmodified). Values are shadcn's neutral seed and are REPLACED with ours in Phase 4 (re-skin) — that is a one-file edit here, no component churn.",
  "background": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },

  "card": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "card-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },

  "popover": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "popover-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },

  "primary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },
  "primary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "secondary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "secondary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },

  "muted": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "muted-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.556, 0, 0] } },

  "accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "accent-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },

  "destructive": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.577, 0.245, 27.325] } },
  "destructive-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0.01, 17] } },

  "border": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
  "input": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
  "ring": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] } },

  "backdrop": {
    "$type": "color",
    "$description": "Dialog/overlay scrim. shadcn hard-codes bg-black/50 with no token behind it, so Figma had nothing to bind. Named per v1's own `backdrop`.",
    "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.4 }
  },

  "shadow-subtle": { "$type": "color", "$description": "Shadow ink. Figma EFFECT STYLES have no mode support, so a theme-aware shadow needs its colour as a variable the effect binds to — these four are that. v1's shadowSubtle.", "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.04 } },
  "shadow-light": { "$type": "color", "$description": "v1's shadowLight.", "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.06 } },
  "shadow-medium": { "$type": "color", "$description": "v1's shadowMedium.", "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.1 } },
  "shadow-strong": { "$type": "color", "$description": "v1's shadowStrong.", "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.14 } },

  "shadow-flat": {
    "$type": "shadow",
    "$description": "Migrated from v1's elevation() (R-09). Light shadows are slate-tinted (#1C2024), not pure black — that tint is why v1's elevation reads warmer than shadcn's fixed black alpha.",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.04 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-low": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-mid": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.1 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-high": {
    "$type": "shadow",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.14 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.04 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  },
  "shadow-overlay": {
    "$type": "shadow",
    "$description": "THE DIALOG SURFACE uses this (D-027), replacing shadcn's shadow-lg.",
    "$value": [
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.14 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": { "colorSpace": "srgb", "components": [0.1098, 0.1255, 0.1412], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ]
  }
}
