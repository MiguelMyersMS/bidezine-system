{
  "$description": "Light-mode semantic colours → :root. Values are shadcn/ui's own, unmodified, so a deployment can be verified against the source before anything is adjusted.",

  "background": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },

  "card": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "card-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },

  "popover": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "popover-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },

  "primary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },
  "primary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

  "secondary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "secondary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },

  "muted": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "muted-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.556, 0, 0] } },

  "accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "accent-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },

  "destructive": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.577, 0.245, 27.325] } },
  "destructive-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0.01, 17] } },

  "success": { "$type": "color", "$description": "bidezine Adjustment (not a shadcn/ui token — shadcn's own upstream source has no success/warning/info concept). Authored fresh for the design system's status-badge vocabulary; matches destructive's lightness/chroma weight, own hue. WCAG contrast vs white text: 4.94:1.", "$value": { "colorSpace": "oklch", "components": [0.527, 0.154, 150.069] } },
  "success-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0.02, 150] } },

  "warning": { "$type": "color", "$description": "bidezine Adjustment. WCAG contrast vs white text: 4.91:1.", "$value": { "colorSpace": "oklch", "components": [0.554, 0.146, 68.36] } },
  "warning-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0.02, 68] } },

  "info": { "$type": "color", "$description": "bidezine Adjustment. WCAG contrast vs white text: 5.17:1.", "$value": { "colorSpace": "oklch", "components": [0.546, 0.215, 262.881] } },
  "info-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0.02, 262] } },

  "border": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
  "input": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
  "ring": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] } },

  "chart-1": { "$type": "color", "$description": "shadcn aliases this to Tailwind's own blue-300; passthrough keeps the same alias instead of resolving it to a literal.", "$value": "var(--color-blue-300)" },
  "chart-2": { "$type": "color", "$value": "var(--color-blue-500)" },
  "chart-3": { "$type": "color", "$value": "var(--color-blue-600)" },
  "chart-4": { "$type": "color", "$value": "var(--color-blue-700)" },
  "chart-5": { "$type": "color", "$value": "var(--color-blue-800)" },

  "sidebar": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
  "sidebar-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0] } },
  "sidebar-primary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
  "sidebar-primary-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
  "sidebar-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
  "sidebar-accent-foreground": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
  "sidebar-border": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
  "sidebar-ring": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] } }
}
