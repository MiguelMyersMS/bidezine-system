{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },

  "include": ["src"],

  // Carried over verbatim from the Sandbox app's own tsconfig, where this same file was excluded
  // for the same reason: it is the real Storybook story file and imports `@storybook/react-vite`
  // and `storybook/test`, neither of which is (or should be) a dependency here. It is kept next to
  // the source it belongs to purely as provenance — `gallery/DefaultDemo.tsx` is the mechanically
  // sliced, byte-faithful extract of this file's `DefaultShell`, and that extract is what actually
  // renders. Nothing imports the story at runtime.
  "exclude": ["src/design-system/gallery/RailNav.stories.tsx"]
}
